# ark-watch — contoh environment (salin ke .env, isi nilai asli dari API.md pribadi)
# .env TIDAK PERNAH di-commit (lihat .gitignore). API.md juga tidak.

# Data institusi (gratis)
FRED_API_KEY=

# Langganan berbayar (cross-val/failover + endpoint unik)
FMP_API_KEY=
EODHD_API_TOKEN=

# Kanal brief & alert (ADR-003) — buat bot via @BotFather, chat_id dari getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional (belum dipakai F0)
TWELVEDATA_API_KEYS=
